{%- liquid
  assign active = section.settings.active
  if active == 'auto'
    assign t = product.title | downcase
    if t contains 'dad'
      assign active = 'low'
    else
      assign active = section.settings.auto_default
    endif
  endif
-%}
<section class="k-fitsec container" id="section-id-{{ section.id }}">
  <div class="k-fitsec__copy">
    {%- if section.settings.eyebrow != blank -%}<p class="k-fitsec__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2 class="k-fitsec__heading">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<div class="k-fitsec__text">{{ section.settings.text }}</div>{%- endif -%}
  </div>
  <div class="k-fitsec__profiles">
    {%- assign profiles = 'low,mid,high' | split: ',' -%}
    {%- for p in profiles -%}
      {%- case p -%}
        {%- when 'low' -%}{%- assign d = 'M10 70 Q60 40 110 70' -%}{%- assign sub = section.settings.low_text -%}
        {%- when 'mid' -%}{%- assign d = 'M10 70 Q60 25 110 70' -%}{%- assign sub = section.settings.mid_text -%}
        {%- else -%}{%- assign d = 'M10 70 Q60 8 110 70' -%}{%- assign sub = section.settings.high_text -%}
      {%- endcase -%}
      <div class="k-fitsec__p{% if p == active %} is-active{% endif %}">
        <svg viewBox="0 0 120 80" aria-hidden="true"><path d="{{ d }}" fill="none" stroke="currentColor" stroke-width="3"/><path d="M8 70H114" stroke="currentColor" stroke-width="3"/></svg>
        <p class="k-fitsec__name">{{ p | capitalize }} profile</p>
        <p class="k-fitsec__sub">{{ sub | escape }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Hat fit guide",
  "settings": [
    { "type": "select", "id": "active", "label": "Highlighted profile", "default": "auto",
      "options": [
        { "value": "auto", "label": "Auto (dad hats = low)" },
        { "value": "low", "label": "Low" },
        { "value": "mid", "label": "Mid" },
        { "value": "high", "label": "High" }
      ] },
    { "type": "select", "id": "auto_default", "label": "Auto: profile for non-dad hats", "default": "high",
      "options": [{ "value": "low", "label": "Low" }, { "value": "mid", "label": "Mid" }, { "value": "high", "label": "High" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find your fit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it sits." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "low_text", "label": "Low profile caption", "default": "Dad hat · unstructured" },
    { "type": "text", "id": "mid_text", "label": "Mid profile caption", "default": "Structured · curved brim" },
    { "type": "text", "id": "high_text", "label": "High profile caption", "default": "Snapback · structured crown" }
  ],
  "presets": [{ "name": "Hat fit guide" }]
}
{% endschema %}
