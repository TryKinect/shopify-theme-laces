{%- comment -%}
  LACES 2026 — Shop by category. Asymmetric photo tiles driven by real collections
  (title + live product count from Shopify), optional image/title overrides per tile.
  Mobile: horizontal snap rail. Desktop: feature tile + 2×2 grid.
{%- endcomment -%}
<div class="l-section{% if section.settings.flush_top %} l-section--flush-top{% endif %}" id="section-id-{{ section.id }}">
  <div class="l-container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="l-sec-head l-reveal">
        <div class="l-sec-head__text">
          {%- if section.settings.eyebrow != blank -%}<p class="l-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="l-display l-display--md l-sec-head__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
          {%- if section.settings.text != blank -%}<p class="l-sec-head__sub">{{ section.settings.text | escape }}</p>{%- endif -%}
        </div>
        {%- if section.settings.link_label != blank -%}
          <div class="l-sec-head__action"><a class="l-link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}{% render 'laces-icon', icon: 'arrow' %}</a></div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="l-tiles{% if section.settings.feature_first %} l-tiles--feature{% endif %}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = block.settings.collection
          assign title = block.settings.title | default: coll.title
          assign url = block.settings.link | default: coll.url | default: routes.all_products_collection_url
          assign image = block.settings.image | default: coll.featured_image
          assign fp = image.presentation.focal_point | default: 'center'
          assign style = '--l-fp: ' | append: fp
          if forloop.first and section.settings.feature_first
            assign sizes = '(min-width: 1024px) 50vw, (min-width: 768px) 50vw, 84vw'
          else
            assign sizes = '(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 74vw'
          endif
          assign delay = forloop.index0 | times: 0.06
          assign delay_style = '--l-delay: ' | append: delay | append: 's'
        -%}
        <a class="l-tile l-reveal{% if image == blank %} l-tile--placeholder{% endif %}" href="{{ url }}" style="{{ delay_style }}" {{ block.shopify_attributes }}>
          {%- if image != blank -%}
            {{ image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: sizes, widths: '400, 600, 800, 1000, 1400', style: style, alt: '' }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
          <div class="l-tile__body">
            <div>
              <h3 class="l-tile__title">{{ title | escape }}</h3>
              {%- if section.settings.show_count and coll != blank -%}
                <span class="l-tile__count">{{ coll.products_count }} {% if coll.products_count == 1 %}style{% else %}styles{% endif %}</span>
              {%- elsif block.settings.caption != blank -%}
                <span class="l-tile__count">{{ block.settings.caption | escape }}</span>
              {%- endif -%}
            </div>
            <span class="l-tile__arrow" aria-hidden="true">{% render 'laces-icon', icon: 'arrow-ne' %}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "LACES · Category tiles",
  "class": "section-l-tiles",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your fit" },
    { "type": "text", "id": "text", "label": "Supporting text" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "feature_first", "label": "Feature the first tile (large)", "default": true },
    { "type": "checkbox", "id": "show_count", "label": "Show live product counts", "default": true },
    { "type": "checkbox", "id": "flush_top", "label": "Remove top padding", "default": false }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image override", "info": "Uses the collection image if empty." },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "caption", "label": "Caption (used when counts are off or no collection)" },
        { "type": "url", "id": "link", "label": "Link override" }
      ]
    }
  ],
  "presets": [
    { "name": "LACES · Category tiles", "blocks": [ { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" } ] }
  ]
}
{% endschema %}
