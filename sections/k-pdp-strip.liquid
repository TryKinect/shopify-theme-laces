{%- liquid
  assign imgs = product.media | where: 'media_type', 'image'
  assign need = section.settings.skip | plus: 2
-%}
{%- if imgs.size >= need -%}
<section class="k-strip" id="section-id-{{ section.id }}">
  {%- for m in imgs offset: section.settings.skip limit: section.settings.count -%}
    <div class="k-strip__item">
      {{ m | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 25vw, 70vw', widths: '450, 700, 900', alt: m.alt | default: product.title }}
    </div>
  {%- endfor -%}
</section>
{%- endif -%}
{% schema %}
{
  "name": "Product photo strip",
  "settings": [
    { "type": "range", "id": "skip", "label": "Skip first images", "min": 0, "max": 4, "step": 1, "default": 1, "info": "Usually the plain product shots; the rest are lifestyle photos." },
    { "type": "range", "id": "count", "label": "Images to show", "min": 2, "max": 6, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Product photo strip" }]
}
{% endschema %}
