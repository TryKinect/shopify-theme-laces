{%- comment -%}
  LACES 2026 — Community strip: real athlete / lifestyle photography already in the store,
  a roster call-to-action tile and the Instagram handle. Captions are merchant-entered;
  nothing is invented.
{%- endcomment -%}
{%- assign photos = section.blocks | where: 'type', 'photo' -%}
<div class="l-section l-community{% if section.settings.color_scheme == 'paper' %} l-section--paper{% endif %}" id="section-id-{{ section.id }}">
  <div class="l-container">
    <div class="l-sec-head l-reveal">
      <div class="l-sec-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="l-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="l-display l-display--md l-sec-head__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="l-sec-head__sub">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.instagram_handle != blank -%}
        <div class="l-sec-head__action">
          <a class="l-link" href="{{ section.settings.instagram_url | default: settings.social_instagram_url }}" target="_blank" rel="noopener">{{ section.settings.instagram_handle | escape }}{% render 'laces-icon', icon: 'arrow-ne' %}</a>
        </div>
      {%- endif -%}
    </div>

    <div class="l-community__grid">
      {%- for block in photos -%}
        {%- liquid
          assign image = block.settings.image
          assign fp = image.presentation.focal_point | default: 'center'
          assign style = '--l-fp: ' | append: fp
          assign tag = 'div'
          if block.settings.link != blank
            assign tag = 'a'
          endif
        -%}
        <{{ tag }} class="l-community__item l-reveal l-reveal--clip" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} style="--l-delay: {{ forloop.index0 | times: 0.05 }}s" {{ block.shopify_attributes }}>
          {%- if image != blank -%}
            {{ image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 1024px) 17vw, (min-width: 768px) 33vw, 50vw', widths: '300, 400, 600, 800', style: style, alt: block.settings.caption | default: image.alt }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
          {%- if block.settings.caption != blank -%}<span class="l-community__cap">{{ block.settings.caption | escape }}</span>{%- endif -%}
        </{{ tag }}>
      {%- endfor -%}

      {%- if section.settings.cta_heading != blank -%}
        <div class="l-community__item l-community__item--cta l-on-dark l-reveal" style="--l-delay: {{ photos.size | times: 0.05 }}s">
          <h3 class="l-display">{{ section.settings.cta_heading | escape }}</h3>
          {%- if section.settings.cta_text != blank -%}<p>{{ section.settings.cta_text | escape }}</p>{%- endif -%}
          {%- if section.settings.cta_label != blank -%}
            <a class="l-link" href="{{ section.settings.cta_link }}"{% if section.settings.cta_link contains 'http' %} target="_blank" rel="noopener"{% endif %}>{{ section.settings.cta_label | escape }}{% render 'laces-icon', icon: 'arrow-ne' %}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "LACES · Community",
  "class": "section-l-community",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The community" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Worn by the ones building what's next" },
    { "type": "text", "id": "text", "label": "Supporting text", "default": "Meet the athletes on our roster, see what they're building, and follow their journeys beyond the game." },
    { "type": "text", "id": "instagram_handle", "label": "Instagram handle", "default": "@laces.athletes" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL", "info": "Defaults to the theme's Instagram setting." },
    { "type": "header", "content": "Roster tile" },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "The Roster" },
    { "type": "text", "id": "cta_text", "label": "Text", "default": "Athletes from across the nation, each with a page to show who they are as a person and a brand." },
    { "type": "text", "id": "cta_label", "label": "Link label", "default": "Explore the roster" },
    { "type": "url", "id": "cta_link", "label": "Link" },
    { "type": "select", "id": "color_scheme", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "paper", "label": "Light grey" } ], "default": "white" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption", "info": "Keep it factual — a city, a collection, or a verified handle." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [ { "name": "LACES · Community", "blocks": [ { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" } ] } ]
}
{% endschema %}
