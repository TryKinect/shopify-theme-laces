{%- comment -%}Catalog feed for kinect-haus.js color-family swatches. Fetched via /collections/all?section_id=k-families{%- endcomment -%}
{%- paginate collection.products by 250 -%}
<script type="application/json" id="k-families-data">
  [
    {%- for p in collection.products -%}
      {"id":"{{ p.id }}","handle":{{ p.handle | json }},"title":{{ p.title | json }},"img":{{ p.featured_media.preview_image | image_url: width: 800 | json }},"available":{{ p.available | json }}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>
{%- endpaginate -%}

{% schema %}
{
  "name": "Kinect families feed",
  "settings": []
}
{% endschema %}
