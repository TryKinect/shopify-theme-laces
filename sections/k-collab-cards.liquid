{%- assign cards = section.blocks | where: 'type', 'card' -%}
<section class="k-collabs section-id-{{ section.id }}" style="--k-cols: {{ cards.size | at_least: 1 | at_most: 5 }};">
  <div class="container">
    <div class="k-collabs__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="k-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="h4 m-0">{{ section.settings.title | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="k-collabs__sub">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link != blank -%}<a class="btn btn--secondary" href="{{ section.settings.link }}">{{ section.settings.link_label | default: 'View all' | escape }}</a>{%- endif -%}
    </div>
    <div class="k-collabs__rail">
      {%- for block in cards -%}
        {%- liquid
          assign k_prod = block.settings.product
          assign k_coll = collections[block.settings.collection]
          assign k_img = block.settings.image | default: k_prod.featured_image | default: k_coll.featured_image
          assign k_url = block.settings.link | default: k_prod.url | default: k_coll.url
        -%}
        <a class="k-collabs__card" href="{{ k_url }}" {{ block.shopify_attributes }}>
          <span class="k-collabs__img">
            {%- if k_img != blank -%}
              {{ k_img | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 25vw, 70vw', widths: '400, 600, 900', alt: block.settings.title }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {%- endif -%}
          </span>
          {%- if block.settings.label != blank -%}<span class="k-collabs__label">{{ block.settings.label | escape }}</span>{%- endif -%}
          <span class="k-collabs__title">{{ block.settings.title | escape }}</span>
          {%- if k_prod != blank -%}<span class="k-collabs__price">{{ k_prod.price | money }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kinect collab cards",
  "class": "section-k-collabs",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collabs" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Designed by athletes" },
    { "type": "text", "id": "text", "label": "Subheading" },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "All collabs" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "card", "name": "Collab", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "LACES x Collab" },
      { "type": "text", "id": "label", "label": "Small label", "info": "e.g. Cal Athletes" },
      { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the product photo." },
      { "type": "product", "id": "product", "label": "Product", "info": "Shows its price; also the default link." },
      { "type": "collection", "id": "collection", "label": "Or a collection", "info": "Used for the photo and link when no product is set." },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [{ "name": "Kinect collab cards" }]
}
{% endschema %}
