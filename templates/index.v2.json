    "k_reviews": {
      "type": "testimonials",
      "blocks": {
        "testimonial_t4VryT": {
          "type": "testimonial",
          "settings": {
            "star_rating": 5,
            "testimonial": "Best hats I’ve ever worn. I got two because I couldn’t decide, the black and white classic color way that Steph was seen wearing and black/Ube. Not only is the style and color way perfect but the hats fit amazingly better than any other hat I own. I also love that it was created by college athletes and buying the hats supports them. So now I’m definitely buying every one for both collections. They fit exactly the way it looks like they do, in the picture of Steph wearing it.",
            "author": "Kris",
            "image": "shopify://shop_images/Bay-Area-Downside-Up-Black-Hat-1.png",
            "image_caption": "Shop Bay Area",
            "link": "shopify://collections/bay-area"
          }
        },
        "16115832006dc80dc9-0": {
          "type": "testimonial",
          "settings": {
            "star_rating": 5,
            "testimonial": "Best looking and fitting hat! The crown is perfect, not too low and not too narrow from the sides, but goes up the sides straight up and looks amazing. I get a ton of compliments and people asking where I got it from.",
            "author": "Charlie",
            "image": "shopify://shop_images/Bay-Area-Vintage-Hat-1.png",
            "image_caption": "Shop Bay Area Vintage",
            "link": "shopify://products/bay-area-vintage-black"
          }
        },
        "16115832006dc80dc9-1": {
          "type": "testimonial",
          "settings": {
            "star_rating": 5,
            "testimonial": "I’ve purchased several hats from Laces and everyone has been a perfect fit and the quality excellent. As for the company’s purpose of helping athletes with the NIL. That’s awesome. Love it! You’ve got my support.",
            "author": "Bryan",
            "image": "shopify://shop_images/Legacy-Earned-Not-Given-Greige-Hat-4.jpg",
            "image_caption": "Shop the Legacy Hat",
            "link": "shopify://products/legacy-earned-not-given-green"
          }
        }
      },
      "block_order": [
        "16115832006dc80dc9-0",
        "16115832006dc80dc9-1",
        "testimonial_t4VryT"
      ],
