          "type": "divider",
          "settings": {
            "show_in_quickbuy": false
          }
        },
        "variant-picker": {
          "type": "variant-picker",
          "settings": {
            "show_single": false,
            "selector_style": "listed",
            "dynamic_availability": "show",
            "enable_size_chart": false,
            "size_chart_label": "Size guide",
            "size_chart_variant": "Size",
            "size_chart_page": ""
          }
        },
        "buy-buttons": {
          "type": "buy-buttons",
          "settings": {
            "show_quantity_selector": true,
            "enable_payment_button": true,
            "show_backorder_text": false,
            "show_pickup_availability": true,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description",
          "settings": {
            "show_in_tab": false,
            "open_tab": false,
            "icon": "",
            "show_in_quickbuy": false
          }
        },
        "accordion_X4DkJx": {
          "type": "accordion",
          "settings": {
            "title": "Fit & Fabric",
            "icon": "",
            "content": "",
            "page": "",
            "custom_liquid": "{%- assign k_t = product.title | downcase -%}{%- if k_t contains 'dad' -%}<ul><li><strong>Soft, Unstructured Crown:</strong> Relaxed and easy-wearing with a low-profile fit that naturally molds to your head over time.</li><li><strong>Washed Twill Fabric:</strong> Soft, broken-in cotton twill with a worn-in feel from the very first wear.</li><li><strong>Curved Brim:</strong> Classic curved brim for an effortless everyday look.</li><li><strong>Adjustable Strap Closure:</strong> Fabric strap with a rubberized metal buckle for a customizable, comfortable fit.</li><li><strong>Low Profile Fit:</strong> Designed with a relaxed silhouette that sits naturally and comfortably.</li><li><strong>Lived-In Feel:</strong> Easygoing, timeless, and made to feel like your favorite hat from day one.</li></ul>{%- else -%}<ul><li><strong>Premium 5-Panel Design</strong>: Sleek and structured, offering a modern fit that’s comfortable for any occasion.</li><li><strong>Adjustable Snapback Closure</strong>: Easily customizable for a secure and comfortable fit every time.</li><li><strong>100% Cotton Fabric</strong>: Soft and breathable, providing a high-quality feel that’s comfortable all day.</li><li><strong>Unisex</strong>: Designed to look great on everyone, adding a versatile edge to any outfit.</li><li><strong>Effortless Comfort and Quality</strong>: Crafted with attention to detail for feel and fit.</li></ul>{%- endif -%}",
            "open": false,
            "variant_content": false,
            "show_in_quickbuy": false
          }
        },
        "accordion_YPRCdX": {
          "type": "accordion",
          "settings": {
            "title": "Shipping & Returns",
            "icon": "",
            "content": "<p><strong>SHIPPING POLICY</strong></p><p>Free shipping on orders $50+</p><p>Please allow 2-3 business days for standard processing before your order ships.<br/><br/><strong>RETURN POLICY</strong></p><p>We have a 30-day return policy, which means you have 30 days after receiving your item to request a return.<br/><br/>To be eligible for a return, your item must be in the same condition that you received it, unworn or unused. You’ll also need the receipt or proof of purchase. </p>",
            "page": "",
            "custom_liquid": "",
            "open": false,
            "variant_content": false,
            "show_in_quickbuy": false
          }
        },
        "k_fit_toggle": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "{% render 'k-fit-toggle', product: product %}",
            "show_in_quickbuy": false
          }
        },
        "k_cal_fundbox": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "{% render 'k-cal-fundbox', product: product, pct: 10 %}",
            "show_in_quickbuy": false
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "k_cal_fundbox",
        "vendor",
        "divider",
        "variant-picker",
        "k_fit_toggle",
        "buy-buttons",
        "description",
        "accordion_X4DkJx",
