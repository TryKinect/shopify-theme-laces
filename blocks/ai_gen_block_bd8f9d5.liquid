{% doc %}
  @prompt
    Split screen view. photo on one side. on the other side, it's a subheading, heading, body text and spcae for a code block below all on the right side with a white background. , the photo should be 50vw, can you change the code block to be a raw html space i can drop in 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-screen-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-split-screen__heading-{{ ai_gen_id }} {
  line-height: 0.8 !important; font-size: 10em !important;
}

  .ai-split-screen__container-{{ ai_gen_id }} {
    display: flex;
    align-items: stretch;
    width: 100%;
    min-height: {{ block.settings.min_height }}px;
  }

  .ai-split-screen__image-side-{{ ai_gen_id }} {
    width: 50vw;
    position: relative;
    overflow: hidden;
  }

  .ai-split-screen__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-split-screen__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-split-screen__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-split-screen__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-split-screen__content-side-{{ ai_gen_id }} {
    flex: 1;
    background-color: {{ block.settings.content_bg_color }};
    padding: {{ block.settings.content_padding }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: {{ block.settings.content_spacing }}px;
  }

  .ai-split-screen__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    font-weight: 400;
    font-family: roboto-mono, monospace;
    text-transform: uppercase;
    letter-spacing: 1.12px;
  }

  .ai-split-screen__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
    font-family: futura-pt-condensed, sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -1px;
  }

  .ai-split-screen__body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    color: {{ block.settings.body_color }};
    line-height: 1.6;
  }

  .ai-split-screen__body-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-split-screen__html-block-{{ ai_gen_id }} {
    margin-top: {{ block.settings.html_spacing }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-split-screen__container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-split-screen__image-side-{{ ai_gen_id }} {
      width: 100%;
      min-height: 300px;
    }

    .ai-split-screen__content-side-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.6 }}px;
    }
  }

  {% if block.settings.layout == 'image_right' %}
    .ai-split-screen__container-{{ ai_gen_id }} {
      flex-direction: row-reverse;
    }

    @media screen and (max-width: 749px) {
      .ai-split-screen__container-{{ ai_gen_id }} {
        flex-direction: column;
      }
    }
  {% endif %}
{% endstyle %}

<split-screen-{{ ai_gen_id }} class="ai-split-screen-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-split-screen__container-{{ ai_gen_id }}">
    <div class="ai-split-screen__image-side-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1500 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-split-screen__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-split-screen__image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-split-screen__empty-state-{{ ai_gen_id }}">
            Add an image
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-split-screen__content-side-{{ ai_gen_id }}">
      {% if block.settings.subheading != blank %}
        <div class="ai-split-screen__subheading-{{ ai_gen_id }}">
          {{ block.settings.subheading }}
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-split-screen__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.body_text != blank %}
        <div class="ai-split-screen__body-{{ ai_gen_id }}">
          {{ block.settings.body_text }}
        </div>
      {% endif %}

      {% if block.settings.custom_html != blank %}
        <div class="ai-split-screen__html-block-{{ ai_gen_id }}">
          {{ block.settings.custom_html }}
        </div>
      {% endif %}
    </div>
  </div>
</split-screen-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Split screen",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "image_left",
          "label": "Image left"
        },
        {
          "value": "image_right",
          "label": "Image right"
        }
      ],
      "default": "image_left"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 400,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Minimum height",
      "default": 600
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "color",
      "id": "content_bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "content_spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Spacing between elements",
      "default": 20
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Early Access"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 12
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Color",
      "default": "#676869"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the community"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 36
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#171717"
    },
    {
      "type": "header",
      "content": "Body text"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Get exclusive access to new features and updates before anyone else.</p>"
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Color",
      "default": "#676869"
    },
    {
      "type": "header",
      "content": "Custom HTML"
    },
    {
      "type": "html",
      "id": "custom_html",
      "label": "HTML content"
    },
    {
      "type": "range",
      "id": "html_spacing",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Top spacing",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Split screen"
    }
  ]
}
{% endschema %}
