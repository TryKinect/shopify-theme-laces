    },
    {
      "type": "color",
      "id": "button_hover_border_color",
      "label": "Hover border",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "color",
      "id": "button_bg_color_secondary",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color_secondary",
      "label": "Text",
      "default": "#232323"
    },
    {
      "type": "color",
      "id": "button_border_color_secondary",
      "label": "Border",
      "default": "#232323"
    },
    {
      "type": "range",
      "id": "button_border_width_secondary",
      "label": "Border width",
      "min": 0,
      "max": 5,
