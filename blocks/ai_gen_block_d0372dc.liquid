      "type": "paragraph",
      "content": "Hover style"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color_secondary",
      "label": "Hover background",
      "default": "#232323"
    },
    {
      "type": "color",
      "id": "button_hover_text_color_secondary",
      "label": "Hover text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_border_color_secondary",
      "label": "Hover border",
      "default": "#232323"
    }
  ],
  "presets": [
    {
      "name": "Product add to cart"
