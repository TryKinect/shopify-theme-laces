{% doc %}
  @prompt
    Split screen view. video on one side. on the other side, it's a subheading, heading, body text and spcae for a code block below all on the right side with a white background. the video should be 50vw, you should also be able to choose right or left side. can you change the code block to be a raw html space i can drop in. 
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-split-video-{{ ai_gen_id }} { display:block; width:100%; max-width:100%; }
  .ai-split-video-{{ ai_gen_id }}__layout { display:flex; width:100%; min-height:{{ block.settings.section_height }}px; background:#fff; }
  .ai-split-video-{{ ai_gen_id }}__media, .ai-split-video-{{ ai_gen_id }}__content { width:50%; min-width:0; }
  .ai-split-video-{{ ai_gen_id }}__media { position:relative; overflow:hidden; background:#f2f2f2; min-height:{{ block.settings.section_height }}px; }
  .ai-split-video-{{ ai_gen_id }}__media video, .ai-split-video-{{ ai_gen_id }}__placeholder { display:block; width:100%; height:100%; min-height:{{ block.settings.section_height }}px; object-fit:cover; }
  .ai-split-video-{{ ai_gen_id }}__placeholder svg { width:100%; height:100%; min-height:{{ block.settings.section_height }}px; object-fit:cover; background:#f2f2f2; }
  .ai-split-video-{{ ai_gen_id }}__empty-state { position:absolute; left:16px; right:16px; bottom:16px; padding:10px 14px; background:rgba(255,255,255,.94); color:#333; font-size:14px; text-align:center; }
  .ai-split-video-{{ ai_gen_id }}__content { display:flex; align-items:center; justify-content:center; padding:{{ block.settings.content_padding }}px; background:#fff; color:#333; }
  .ai-split-video-{{ ai_gen_id }}__inner { width:100%; max-width:{{ block.settings.content_max_width }}px; margin:0 auto; }
  .ai-split-video-{{ ai_gen_id }}__eyebrow { margin:0 0 12px; color:#333; font-size:14px; letter-spacing:.08em; text-transform:uppercase; }
  .ai-split-video-{{ ai_gen_id }}__heading { margin:0 0 16px; color:#171717; font-size:{{ block.settings.heading_size }}px; line-height:1.15; }
  .ai-split-video-{{ ai_gen_id }}__body { color:#333; font-size:16px; line-height:1.6; }
  .ai-split-video-{{ ai_gen_id }}__body p { margin:0 0 1em; }
  .ai-split-video-{{ ai_gen_id }}__body p:last-child { margin-bottom:0; }
  .ai-split-video-{{ ai_gen_id }}__html { margin-top:24px; width:100%; }
  .ai-split-video-{{ ai_gen_id }}__layout--video-right .ai-split-video-{{ ai_gen_id }}__media { order:2; }
  .ai-split-video-{{ ai_gen_id }}__layout--video-right .ai-split-video-{{ ai_gen_id }}__content { order:1; }
  @media screen and (max-width:749px) {
    .ai-split-video-{{ ai_gen_id }}__layout { flex-direction:column; min-height:0; }
    .ai-split-video-{{ ai_gen_id }}__media, .ai-split-video-{{ ai_gen_id }}__content { width:100%; }
    .ai-split-video-{{ ai_gen_id }}__media, .ai-split-video-{{ ai_gen_id }}__media video, .ai-split-video-{{ ai_gen_id }}__placeholder, .ai-split-video-{{ ai_gen_id }}__placeholder svg { min-height:{{ block.settings.mobile_video_height }}px; }
    .ai-split-video-{{ ai_gen_id }}__content { padding:32px 22px; }
    .ai-split-video-{{ ai_gen_id }}__layout--video-right .ai-split-video-{{ ai_gen_id }}__media, .ai-split-video-{{ ai_gen_id }}__layout--video-right .ai-split-video-{{ ai_gen_id }}__content { order:initial; }
    .ai-split-video-{{ ai_gen_id }}__heading { font-size:{{ block.settings.mobile_heading_size }}px; }
  }
{% endstyle %}
<div class="ai-split-video-{{ ai_gen_id }}" style="width:{{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  <div class="ai-split-video-{{ ai_gen_id }}__layout {% if block.settings.video_side == 'right' %}ai-split-video-{{ ai_gen_id }}__layout--video-right{% endif %}">
    <div class="ai-split-video-{{ ai_gen_id }}__media">
      {% if block.settings.video != blank %}
        {{ block.settings.video | video_tag: autoplay: block.settings.autoplay, loop: block.settings.loop, muted: block.settings.muted, controls: block.settings.show_controls, playsinline: true }}
      {% else %}
        <div class="ai-split-video-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<div class="ai-split-video-{{ ai_gen_id }}__empty-state">Add a video in the block settings</div></div>
      {% endif %}
    </div>
    <div class="ai-split-video-{{ ai_gen_id }}__content"><div class="ai-split-video-{{ ai_gen_id }}__inner">
      {% if block.settings.subheading != blank %}<p class="ai-split-video-{{ ai_gen_id }}__eyebrow">{{ block.settings.subheading | escape }}</p>{% endif %}
      {% if block.settings.heading != blank %}<h2 class="ai-split-video-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
      {% if block.settings.body != blank %}<div class="ai-split-video-{{ ai_gen_id }}__body">{{ block.settings.body }}</div>{% endif %}
      {% if block.settings.custom_html != blank %}<div class="ai-split-video-{{ ai_gen_id }}__html">{{ block.settings.custom_html }}</div>{% endif %}
    </div></div>
  </div>
</div>
{% schema %}
{
  "name": "Split video and text",
  "settings": [
    {"type":"video","id":"video","label":"Video"},
    {"type":"select","id":"video_side","label":"Video side","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}],"default":"left"},
    {"type":"checkbox","id":"autoplay","label":"Autoplay","default":true},
    {"type":"checkbox","id":"loop","label":"Loop video","default":true},
    {"type":"checkbox","id":"muted","label":"Mute video","default":true},
    {"type":"checkbox","id":"show_controls","label":"Show video controls","default":false},
    {"type":"text","id":"subheading","label":"Subheading","default":"A closer look"},
    {"type":"text","id":"heading","label":"Heading","default":"Made for your next move"},
    {"type":"richtext","id":"body","label":"Body text","default":"<p>Share the story behind your video and give visitors a reason to explore more.</p>"},
    {"type":"html","id":"custom_html","label":"Custom HTML"},
    {"type":"header","content":"Layout"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"section_height","label":"Video area height","min":300,"max":900,"step":50,"unit":"px","default":600},
    {"type":"range","id":"mobile_video_height","label":"Mobile video height","min":200,"max":600,"step":25,"unit":"px","default":350},
    {"type":"range","id":"content_padding","label":"Content padding","min":20,"max":100,"step":5,"unit":"px","default":60},
    {"type":"range","id":"content_max_width","label":"Text max width","min":300,"max":800,"step":25,"unit":"px","default":525},
    {"type":"range","id":"heading_size","label":"Heading size","min":24,"max":64,"step":2,"unit":"px","default":42},
    {"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":20,"max":44,"step":2,"unit":"px","default":30}
  ],
  "presets":[{"name":"Split video and text"}],
  "tag":null,
  "class":"split-video-text-block"
}
{% endschema %}