{% doc %}
  @prompt
    full bleed image background with an image block to place on top
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-fullbleed-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.min_height }}px;
    overflow: hidden;
    display: block;
  }

  .ai-fullbleed-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-fullbleed-bg-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.bg_image_position }};
  }

  .ai-fullbleed-bg-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-fullbleed-bg-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-fullbleed-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-fullbleed-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .ai-fullbleed-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: {{ block.settings.vertical_alignment }};
    justify-content: {{ block.settings.horizontal_alignment }};
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-fullbleed-fg-wrapper-{{ ai_gen_id }} {
    max-width: {{ block.settings.fg_max_width }}px;
    width: 100%;
  }

  .ai-fullbleed-fg-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.fg_border_radius }}px;
    box-shadow: {{ block.settings.fg_shadow_horizontal }}px {{ block.settings.fg_shadow_vertical }}px {{ block.settings.fg_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.fg_shadow_opacity | divided_by: 100.0 }});
  }

  .ai-fullbleed-fg-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.fg_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
  }

  .ai-fullbleed-fg-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  @media screen and (max-width: 749px) {
    .ai-fullbleed-container-{{ ai_gen_id }} {
      min-height: {{ block.settings.min_height_mobile }}px;
    }

    .ai-fullbleed-content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding_mobile }}px;
    }

    .ai-fullbleed-fg-wrapper-{{ ai_gen_id }} {
      max-width: 100%;
    }
  }
{% endstyle %}

<full-bleed-image-{{ ai_gen_id }}
  class="ai-fullbleed-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-fullbleed-bg-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2400 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
        class="ai-fullbleed-bg-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-fullbleed-bg-placeholder-{{ ai_gen_id }}">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
        <div class="ai-fullbleed-empty-state-{{ ai_gen_id }}">
          Add a background image
        </div>
      </div>
    {% endif %}
  </div>

  {% if block.settings.show_overlay %}
    <div class="ai-fullbleed-overlay-{{ ai_gen_id }}"></div>
  {% endif %}

  <div class="ai-fullbleed-content-{{ ai_gen_id }}">
    <div class="ai-fullbleed-fg-wrapper-{{ ai_gen_id }}">
      {% if block.settings.foreground_image %}
        <img
          src="{{ block.settings.foreground_image | image_url: width: 1200 }}"
          alt="{{ block.settings.foreground_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.foreground_image.width }}"
          height="{{ block.settings.foreground_image.height }}"
          class="ai-fullbleed-fg-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-fullbleed-fg-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
  </div>
</full-bleed-image-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Full bleed image",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "bg_image_position",
      "label": "Background position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 200,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Minimum height (desktop)",
      "default": 600
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Minimum height (mobile)",
      "default": 400
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 30
    },
    {
      "type": "header",
      "content": "Foreground image"
    },
    {
      "type": "image_picker",
      "id": "foreground_image",
      "label": "Foreground image"
    },
    {
      "type": "range",
      "id": "fg_max_width",
      "min": 200,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Maximum width",
      "default": 600
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "Horizontal position",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical position",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_padding_mobile",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Padding (mobile)",
      "default": 20
    },
    {
      "type": "header",
      "content": "Foreground image style"
    },
    {
      "type": "range",
      "id": "fg_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "fg_shadow_horizontal",
      "min": -20,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Shadow horizontal offset",
      "default": 0
    },
    {
      "type": "range",
      "id": "fg_shadow_vertical",
      "min": -20,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Shadow vertical offset",
      "default": 4
    },
    {
      "type": "range",
      "id": "fg_shadow_blur",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Shadow blur",
      "default": 20
    },
    {
      "type": "range",
      "id": "fg_shadow_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Shadow opacity",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Full bleed image"
    }
  ]
}
{% endschema %}
