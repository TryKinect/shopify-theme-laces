{%- comment -%}
  Cal PDP: "X% to the athlete + Y% to the Fund" box + optional Athlete Fund add-on.
  When checked, the hat form (main or sticky) is rewritten to items[0]=hat, items[1]=fund so the theme's
  own AJAX add sends both in one all-or-nothing request; theme error handling shows failures.
{%- endcomment -%}
{%- liquid
  assign pct = pct | default: 10
  assign athlete_pct = athlete_pct | default: 20
  assign fund = all_products['cal-athletes-fund']
  assign fund_v = fund.selected_or_first_available_variant
-%}
<div class="k-calbox">
  {{ 'k-cal-fund.jpg' | asset_img_url: '160x' | img_tag: '', 'k-calbox__img' }}
  <div>
    <p class="k-calbox__title">{{ athlete_pct }}% to the athlete + {{ pct }}% to the Fund</p>
    <p class="k-calbox__text">Each attributed athlete gets {{ athlete_pct }}% of this hat. The {{ pct }}% that goes to the Cal LACES Athlete Fund is split among every Cal athlete who meets their monthly benchmarks. <a href="/pages/cal-athletes">How it works</a></p>
  </div>
</div>
{%- if fund_v.available -%}
  <label class="k-caladd">
    <input type="checkbox" class="k-caladd__cb" data-k-fund-variant="{{ fund_v.id }}">
    <span><strong>Add {{ fund_v.price | money_without_trailing_zeros }} to the Athlete Fund</strong><br>Split among Cal athletes who meet their monthly benchmarks. Not tax-deductible, non-refundable.</span>
  </label>
  <script>
    (function(){
      var cb=document.currentScript.previousElementSibling.querySelector('.k-caladd__cb');
      var pid='{{ product.id }}';
      var added=[];
      function restore(){
        added.forEach(function(el){el.remove();});
        document.querySelectorAll('[data-k-fund-renamed]').forEach(function(el){el.name=el.getAttribute('data-k-fund-renamed');el.removeAttribute('data-k-fund-renamed');});
        added=[];
      }
      function hidden(form,name,val){var i=document.createElement('input');i.type='hidden';i.name=name;i.value=val;form.appendChild(i);added.push(i);}
      document.addEventListener('submit',function(e){
        var form=e.target;
        if(!cb.checked||!form.matches||!form.matches('form.js-product-form')||form.getAttribute('data-product-id')!==pid)return;
        restore();
        var id=form.querySelector('[name="id"]');
        if(!id)return;
        var qty=form.querySelector('[name="quantity"]');
        hidden(form,'items[0][id]',id.value);
        hidden(form,'items[0][quantity]',qty?qty.value:1);
        hidden(form,'items[1][id]',cb.getAttribute('data-k-fund-variant'));
        hidden(form,'items[1][quantity]','1');
        id.setAttribute('data-k-fund-renamed','id');id.name='k_id';
        if(qty){qty.setAttribute('data-k-fund-renamed','quantity');qty.name='k_quantity';}
      },true);
      document.addEventListener('on:cart:add',function(){if(added.length){restore();cb.checked=false;}});
      document.addEventListener('on:cart:error',function(){if(added.length)restore();});
    })();
  </script>
{%- endif -%}
