{%- comment -%}
  Cal PDP: "$X goes to Cal athletes" box + optional Athlete Fund add-on.
  The add-on adds the fund variant via /cart/add.js, then lets the theme's own add-to-cart run.
{%- endcomment -%}
{%- liquid
  assign pct = pct | default: 10
  assign fund_cut = product.price | times: pct | divided_by: 100.0 | round
  assign fund = all_products['cal-athletes-fund']
  assign fund_v = fund.selected_or_first_available_variant
-%}
<div class="k-calbox">
  {{ 'k-cal-fund.jpg' | asset_img_url: '160x' | img_tag: '', 'k-calbox__img' }}
  <div>
    <p class="k-calbox__title">{{ fund_cut | money }} goes to Cal athletes</p>
    <p class="k-calbox__text">{{ pct }}% of this hat goes into the Cal LACES Athlete Fund, split equally across every sport. <a href="/pages/cal-athletes">How it works</a></p>
  </div>
</div>
{%- if fund_v.available -%}
  <label class="k-caladd">
    <input type="checkbox" class="k-caladd__cb" data-k-fund-variant="{{ fund_v.id }}">
    <span><strong>Add {{ fund_v.price | money_without_trailing_zeros }} to the Athlete Fund</strong><br>Goes to every Cal athlete. Not tax-deductible, non-refundable.</span>
  </label>
  <script>
    (function(){
      var cb=document.currentScript.previousElementSibling.querySelector('.k-caladd__cb');
      var root=cb.closest('.product-form')||document;
      var busy=false;
      root.addEventListener('click',function(e){
        var btn=e.target.closest('button[name="add"]');
        if(!btn||!cb.checked||busy)return;
        e.preventDefault();e.stopImmediatePropagation();
        busy=true;
        fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[{id:+cb.getAttribute('data-k-fund-variant'),quantity:1}]})})
          .catch(function(){})
          .then(function(){cb.checked=false;btn.click();busy=false;});
      },true);
    })();
  </script>
{%- endif -%}
